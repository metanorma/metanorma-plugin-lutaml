			<element xmi:idref="EAID_2976C38F_E951_414b_92D2_BC95397C9860" xmi:type="uml:Class" name="ADEOfWaterBody" scope="public">
				<model package="EAPK_354816A2_DEFC_4506_BBF6_BC0CD3EFF57D" tpos="0" ea_localid="649" ea_eleType="element"/>
