			<element xmi:idref="EAID_FA65EA18_9554_4ab4_B1EB_8C34EFD57926" xmi:type="uml:Class" name="DmAnnotation" scope="public">
				<model package="EAPK_BCC79C61_EB22_4305_B574_693E41527057" tpos="0" ea_localid="403" ea_eleType="element"/>
				<properties documentation="都市計画基本図として、注記を表現するために必要な情報のデータ型。 +&#xA;地物（ステレオタイプがFeatureType）は、関連役割uro:dmAttributeにより、uro:DmAnnotationを保持できる。このとき、uro:DmAnnotationは地物に付属する情報となる。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="DataType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

