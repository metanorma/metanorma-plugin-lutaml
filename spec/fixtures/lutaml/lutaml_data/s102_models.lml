// s102_models.lml
models IhoS102Check {
  enum CheckClassification {
    critical_error {
      description "Critical Error"
    }
    warning {
      description "Warning"
    }
  }

  class ValidationChecks {
    attribute checks {
      type ValidationCheck
      cardinality 0..n
    }
  }

  class ValidationCheck {
    attribute dev_id {
      type String
      cardinality 1
    }

    attribute classification {
      type CheckClassification
      cardinality 1
    }

    attribute check_message {
      type String
      cardinality 1
    }

    attribute check_description {
      type String
      cardinality 0..1
    }

    attribute check_solution {
      type String
      cardinality 0..1
    }
  }
}
