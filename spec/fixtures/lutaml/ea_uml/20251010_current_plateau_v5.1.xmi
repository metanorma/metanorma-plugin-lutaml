				<model package="EAPK_D13F9655_87C9_40da_88DB_662F687AA460" tpos="0" ea_localid="538" ea_eleType="element"/>
				<properties documentation="橋梁の立体形状の底面。 +&#xA;橋梁の底面又は橋梁の壁面と地形との交線を境界とする面とする。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

