					<tag xmi:id="EAID_26B33348_211E_5f21_BD76_F2B25B896768" name="isCollection" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Identifies the class as a collection&#xA;" modelElement="EAID_051B541D_8E88_4053_8BEE_243293BA99C6"/>
