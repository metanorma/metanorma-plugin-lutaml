SCHEMA security_classification_schema '{iso standard 10303 part(41) version(3) object(1) security-classification-schema(21)}';
  REFERENCE FROM support_resource_schema (label, text);
  ENTITY security_classification;
    name : label;
    purpose : text;
    security_level : security_classification_level;
  END_ENTITY;

  ENTITY security_classification_level;
    name : label;
  END_ENTITY;

END_SCHEMA;

