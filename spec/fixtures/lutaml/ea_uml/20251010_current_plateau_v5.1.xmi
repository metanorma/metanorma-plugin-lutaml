					<tag xmi:id="EAID_F9638764_B69A_b0b6_A13D_114E30D09DFF" name="noPropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Suppress creation of a named complex type ( property type ) that supports inline or byReference encoding&#xA;" modelElement="EAID_EA0676C4_840E_4edf_937E_7D3311C57483"/>
