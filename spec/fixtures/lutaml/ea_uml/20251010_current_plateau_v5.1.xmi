			<element xmi:idref="EAID_3123EFB1_B5FE_4803_AD97_648ABE18B519" xmi:type="uml:Class" name="FloorSurface" scope="public">
				<model package="EAPK_1D38D48C_F798_4ab9_AFDB_A6140AB461D4" tpos="0" ea_localid="563" ea_eleType="element"/>
				<properties documentation="建物の内部空間の各階下面に位置する水平で平らな板状の構造物（床面）。部屋（bldg:Room）の境界面となる。&#xA;&#xA;.bldg:FloorSurfaceの例&#xA;image::images/057.webp.png[width=&quot;300&quot;]&#xA;&#xA;bldg:FloorSurfaceの法線ベクトルは上向き（部屋の内側に向く方向が正）となる。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

				<tags>
					<tag xmi:id="EAID_ED33D65F_DF35_1ddf_BA67_1B4375D0529A" name="byValuePropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Create a named complex type ( property type ) that requires the instance to be encoded inline&#xA;" modelElement="EAID_3123EFB1_B5FE_4803_AD97_648ABE18B519"/>
