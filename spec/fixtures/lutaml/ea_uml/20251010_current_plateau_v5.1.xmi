				<target xmi:idref="EAID_E94072DC_65E4_43b6_9FD3_DFF37000AE82">
					<model ea_localid="177" type="Class" name="AuxiliaryTrafficArea"/>
					<role visibility="Public" targetScope="instance"/>
					<type aggregation="none" containment="Unspecified"/>
