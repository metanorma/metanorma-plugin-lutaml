			<element xmi:idref="EAID_4BA9268E_89AE_4dc3_A775_6D5A331AAA1E" xmi:type="uml:Class" name="CeilingSurface" scope="public">
				<model package="EAPK_D13F9655_87C9_40da_88DB_662F687AA460" tpos="0" ea_localid="529" ea_eleType="element"/>
