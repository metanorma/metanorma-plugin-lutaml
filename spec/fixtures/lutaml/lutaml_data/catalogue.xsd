<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:c="urn:cat" targetNamespace="urn:cat" elementFormDefault="qualified">
  <xs:complexType name="widgetType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="mass" type="xs:decimal" minOccurs="0"/>
      <xs:element name="tag" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:element name="widgets">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="widget" type="c:widgetType" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
