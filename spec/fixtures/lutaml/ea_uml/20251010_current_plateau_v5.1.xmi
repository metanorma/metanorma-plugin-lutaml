					<tag xmi:id="EAID_26B33348_AEB2_0bae_8C14_6BDE7F7BA53C" name="isCollection" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Identifies the class as a collection&#xA;" modelElement="EAID_3193F911_5122_42fd_A080_8BB80D3CF7D1"/>
