					<tags>
						<tag xmi:id="EAID_08A8199D_34EA_8c34_B431_235192E5F4C2" name="isMetadata" value="false$ea_notes=Values: true,false&#xA;Default: false&#xA;Description: If 'true', the property type will extend GML AbstractMetadataPropertyType. Else, it will extend GML AbstractMemberType.&#xA;"/>
						<tag xmi:id="EAID_37DFCA0A_33B7_f633_A0F5_B12D3CD07557" name="inlineOrByReference" value="inline$ea_notes=Values: byReference,inline&#xA;Default: inline&#xA;Description: Determines whether the property value will be encoded inline or by reference&#xA;"/>
