			<element xmi:idref="EAID_06D35662_D7A0_46fe_AB5A_05970BD380BE" xmi:type="uml:Class" name="GroundSurface" scope="public">
				<model package="EAPK_1D38D48C_F798_4ab9_AFDB_A6140AB461D4" tpos="0" ea_localid="559" ea_eleType="element"/>
				<properties documentation="建築物の立体形状の底面。 +&#xA;建築物の底面又は建築物の外壁面と地表面との交線を境界とする面を取得する。&#xA;&#xA;.bldg:GroundSurface&#xA;image::images/049.webp.png[width=&quot;400&quot;]" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

				<tags>
