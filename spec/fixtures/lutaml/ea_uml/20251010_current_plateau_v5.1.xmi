			<element xmi:idref="EAID_27886C81_3B89_42bc_BC63_B3CC5EEFC837" xmi:type="uml:Class" name="OuterCeilingSurface" scope="public">
				<model package="EAPK_1D38D48C_F798_4ab9_AFDB_A6140AB461D4" tpos="0" ea_localid="556" ea_eleType="element"/>
				<properties documentation="建築物の外側を覆う部分であり、天井としての機能を有する部分。&#xA;&#xA;.bldg:OuterCeilingSurfaceの例&#xA;image::images/050.webp.png[width=&quot;300&quot;]&#xA;&#xA;ユースケースで屋外の天井と外壁面との区分が必要な場合に、bldg:OuterCeilingSurfaceを使用する。 +&#xA;ユースケースで屋外の天井と外壁面との区分が不要な場合には、この型は使用せず、bldg:WallSurfaceを使用する。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

