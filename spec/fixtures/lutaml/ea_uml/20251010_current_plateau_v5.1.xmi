						<tag xmi:id="EAID_37DFCA0A_33B7_f633_A2C5_1C99259FC580" name="inlineOrByReference" value="inline$ea_notes=Values: byReference,inline&#xA;Default: inline&#xA;Description: Determines whether the property value will be encoded inline or by reference&#xA;"/>
						<tag xmi:id="EAID_E810E922_7AEF_c27a_8557_B01B761B0B16" name="sequenceNumber" value="$ea_notes=Description: Unique integer value to order the properties of a class&#xA;"/>
