			<element xmi:idref="EAID_445424B4_89D6_44b1_AD5D_CDE5110FA344" xmi:type="uml:Class" name="BuildingFurniture" scope="public">
				<model package="EAPK_1D38D48C_F798_4ab9_AFDB_A6140AB461D4" tpos="0" ea_localid="558" ea_eleType="element"/>
				<properties documentation="室内の移動できる備品（家具）。 +&#xA;bldg:IntBuildingInstallationが、建築物内部に設置された恒久的かつ固定的な設備であることと対照的に、bldg:BuildingFurnitureは椅子やテーブルのような、動かすことができる備品である。&#xA;&#xA;.bldg:BuildingFurnitureの例（机、椅子）&#xA;image::images/065.webp.png[width=&quot;300&quot;]&#xA;&#xA;LOD4.2の場合にのみ取得する。 +&#xA;ただし、ユースケースの要求に応じて、取得対象とする家具を限定してよい。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

				<tags>
