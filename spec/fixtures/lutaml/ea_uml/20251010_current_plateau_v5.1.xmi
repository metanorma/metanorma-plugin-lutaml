					<tag xmi:id="EAID_26B33348_211E_5f21_BFBE_61CB4F8E3B3E" name="isCollection" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Identifies the class as a collection&#xA;" modelElement="EAID_BE44DD8A_DBC5_4e5e_8658_3D7E51C0DF5D"/>
					<tag xmi:id="EAID_F9638764_B69A_b0b6_9C4C_BCED5841E046" name="noPropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Suppress creation of a named complex type ( property type ) that supports inline or byReference encoding&#xA;" modelElement="EAID_BE44DD8A_DBC5_4e5e_8658_3D7E51C0DF5D"/>
