				<attributes>
					<attribute xmi:idref="EAID_152855EC_CDA4_49cb_A958_F2DAA83FECFB" name="buildingHeightLimits" scope="Public">
						<initial/>
						<documentation value="都市計画法第8条第3項第2号チに定める当該地区における市街地の環境を確保するために必要な場合に定められた建築物の高さの最高限度。単位はm（uom=&quot;m&quot;）とする。"/>
