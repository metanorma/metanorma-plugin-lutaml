				<model ea_localid="180"/>
				<properties ea_type="Aggregation" subtype="Weak" direction="Destination -&gt; Source"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<documentation value="道路、徒歩道又は広場の場合は、これらを構成する要素のうち、交通領域の機能を補助する領域。&#xA;&#xA;鉄道の場合は、鉄道用地を構成する要素のうち、交通領域（軌道）の機能を補助する領域。&#xA;&#xA;航路の場合は、この関連役割は使用しない。&#xA;"/>
				
