			<element xmi:idref="EAID_47C26038_F918_4922_BB78_CB222B3ECD4B" xmi:type="uml:Class" name="FloorSurface" scope="public">
				<model package="EAPK_D13F9655_87C9_40da_88DB_662F687AA460" tpos="0" ea_localid="533" ea_eleType="element"/>
