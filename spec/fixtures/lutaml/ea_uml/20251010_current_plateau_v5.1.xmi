			<element xmi:idref="EAID_9713463F_4AE0_4259_9254_337D505F4B28" xmi:type="uml:Class" name="OuterCeilingSurface" scope="public">
				<model package="EAPK_BCC79C61_EB22_4305_B574_693E41527057" tpos="0" ea_localid="495" ea_eleType="element"/>
