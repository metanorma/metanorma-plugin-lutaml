					<tag xmi:id="EAID_26B33348_211E_5f21_B26B_3A29EF7AC232" name="isCollection" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Identifies the class as a collection&#xA;" modelElement="EAID_785EF02A_B27D_4189_AE5F_06F817EF9340"/>
