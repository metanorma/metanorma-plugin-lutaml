					<tag xmi:id="EAID_F9638764_B69A_b0b6_8780_AED69A951501" name="noPropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Suppress creation of a named complex type ( property type ) that supports inline or byReference encoding&#xA;" modelElement="EAID_FC6D4B12_6ABA_485d_A5C3_F203B450BAFA"/>
				</tags>
				
