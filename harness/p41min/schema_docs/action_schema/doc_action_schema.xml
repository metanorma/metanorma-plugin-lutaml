601" anchor="action_schema.versioned_action_request"/><bookmark id="_5dce3e93-e29d-3e4b-2b91-5e09e9182062" anchor="versioned_action_request.id"/><bookmark id="_f69e0796-dc3e-6d1d-d398-0305ca37ee28" anchor="versioned_action_request.version"/><bookmark id="_514947c8-6c0c-24ba-6a42-72acf9832e7d" anchor="versioned_action_request.purpose"/><bookmark id="_f3b0bb4f-a23b-ef95-5e5d-347ad5225d29" anchor="versioned_action_request.description"/><bookmark id="_67d4bd99-1b4e-ab53-ecaa-a72e47c0ca6b" anchor="action_schema.versioned_action_request_relationship"/><bookmark id="_a5d69850-ec2a-a285-9f51-94c73ee0c5f9" anchor="versioned_action_request_relationship.id"/><bookmark id="_b6f67999-fcac-e113-e9da-29640062608a" anchor="versioned_action_request_relationship.name"/><bookmark id="_4a2c134e-836f-1c09-9c4b-d3c42a9760ba" anchor="versioned_action_request_relationship.description"/><bookmark id="_9f6caa40-572f-4db5-d3d2-5e809fabd238" anchor="versioned_action_request_relationship.relating_versioned_action_request"/><bookmark id="_ef3c1374-ea4d-0052-5796-ce21c2b04056" anchor="versioned_action_request_relationship.related_versioned_action_request"/><bookmark id="_64cec8b0-ec24-3f6d-0ec8-fa1a3691e275" anchor="action_schema.action_directive_relationship"/><bookmark id="_eb7d58b9-cb16-4dc0-036a-3f8880416883" anchor="action_directive_relationship.name"/><bookmark id="_e559b65e-d44f-4915-e42a-60fda6d5b3fc" anchor="action_directive_relationship.description"/><bookmark id="_c4a3c7b1-316f-fee7-a9cf-9b4503febc91" anchor="action_directive_relationship.relating"/><bookmark id="_d69df44e-9b46-d9a9-95ff-84793ea84d8d" anchor="action_directive_relationship.related"/><bookmark id="_20587e27-ed55-3699-4983-d029367fc28d" anchor="action_directive_relationship.relation_type"/><bookmark id="_7a161660-3c46-50b7-2cc4-0ced2c8cc794" anchor="action_schema.functions"/><bookmark id="_3e07bed7-0133-2ac9-5d2e-2562b6ba491a" anchor="action_schema.acyclic_action_method_relationship"/><bookmark id="_347f3dc5-fbcb-663c-8bb