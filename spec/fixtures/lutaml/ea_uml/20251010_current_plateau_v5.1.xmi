				<model package="EAPK_939925FF_6235_4286_82FF_7392B33F305C" tpos="0" ea_localid="136" ea_eleType="element"/>
				<properties documentation="線の集まり。ただし、集まりを構成する最初の線を除く各線が直前の線の終点から始まる（方向が揃った有向曲線となる）。始点と終点以外の点の座標が、ほかの点の座標と一致してはならず、また、自己交差や重なりがあってはならない。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Type" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

				<tags>
