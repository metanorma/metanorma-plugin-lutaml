			<element xmi:idref="EAID_1E74EDB4_DB17_4472_98E5_16399BDD9169" xmi:type="uml:Class" name="BridgeRoom" scope="public">
				<model package="EAPK_D13F9655_87C9_40da_88DB_662F687AA460" tpos="0" ea_localid="535" ea_eleType="element"/>
				<properties documentation="壁、間仕切り、床、天井などで仕切られた、橋梁内部に設けられた区画。 +&#xA;橋梁にこれと一体となった建屋が存在し、その内部空間を表現する場合に使用する。 +&#xA;brid:BridgeRoomは橋梁内部の区画を区切る境界面（brid:_BoundarySurfaceの下位型）及びこの境界面の開口部（brid:_Openingの下位型）、brid:BridgeRoomに付属する固定的な設備（brid:IntBridgeInstallation）及び、brid:BridgeRoomに設置された可動設備（brid:BridgeFurniture）の集まりからなる。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

