			<element xmi:idref="EAID_B6AEED4A_CB36_47b4_8384_4F0831340F89" xmi:type="uml:Class" name="AreaClassification" scope="public">
				<model package="EAPK_703CD7E4_9939_4370_8AEB_B5B48ACC572F" tpos="7" ea_localid="306" ea_eleType="element"/>
				<properties documentation="都市計画法第7条に基づき、無秩序な市街地の拡大による環境悪化の防止、計画的な公共施設整備などによる良好な市街地の形成などを行うため、都市計画区域について区分された、計画的な市街化を図るべき区域「市街化区域」と、市街化を抑制すべき「市街化調整区域」。（都市計画法第7条）&#xA;&#xA;.区域区分（市街化調整地域）の例&#xA;image::images/229.webp.png[width=&quot;300&quot;]&#xA;&#xA;複数の市区町村にまたがる市街化区域又は市街化調整区域の場合は、市区町村の境界で区切る。&#xA;&#xA;* 属性urf:functionは、コードリスト（&amp;lt;&amp;lt;Common_areaClassificationType.xml,Common_areaClassificationType.xml&amp;gt;&amp;gt;）より選択する。&#xA;* 属性urf:usage、urf:areaClassificationType及びurf:locationは、使用しない。&#xA;* 属性core:creationDateは運用上必須とする。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

				<tags>
					<tag xmi:id="EAID_ED33D65F_DF35_1ddf_B23D_7874C9FD1765" name="byValuePropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Create a named complex type ( property type ) that requires the instance to be encoded inline&#xA;" modelElement="EAID_B6AEED4A_CB36_47b4_8384_4F0831340F89"/>
					<tag xmi:id="EAID_26B33348_211E_5f21_95E9_351718168769" name="isCollection" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Identifies the class as a collection&#xA;" modelElement="EAID_B6AEED4A_CB36_47b4_8384_4F0831340F89"/>
