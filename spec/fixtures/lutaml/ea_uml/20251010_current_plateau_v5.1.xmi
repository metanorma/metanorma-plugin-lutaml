					<attribute xmi:idref="EAID_872FA301_793D_4327_8036_FC6B63ADB713" name="function" scope="Public">
						<initial/>
						<documentation value="区画線や路面標示、道路標識等により示された交通補助領域の機能。コードリスト（&amp;lt;&amp;lt;AuxiliaryTrafficArea_function.xml,AuxiliaryTrafficArea_function.xml&amp;gt;&amp;gt;）より選択する。鉄道及び航路の場合は使用しない。"/>
