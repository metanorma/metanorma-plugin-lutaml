					<tag xmi:id="EAID_F9638764_B69A_b0b6_B16A_DDF2DBBA6301" name="noPropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Suppress creation of a named complex type ( property type ) that supports inline or byReference encoding&#xA;" modelElement="EAID_05413E4E_1FF0_4a2d_83C1_81C3EA830C96"/>
				</tags>
				
