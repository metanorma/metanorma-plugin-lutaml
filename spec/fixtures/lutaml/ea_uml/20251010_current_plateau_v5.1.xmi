			<element xmi:idref="EAID_A593DC46_8B05_4cad_BA5F_D605807A7F86" xmi:type="uml:Class" name="Window" scope="public">
				<model package="EAPK_1D38D48C_F798_4ab9_AFDB_A6140AB461D4" tpos="0" ea_localid="564" ea_eleType="element"/>
				<properties documentation="採光、通風、換気、眺望などの目的のため、建築物の屋根又は壁、部屋の天井、壁、床に設けられた開口部のうち、人や物の出入りを目的としないもの。&#xA;&#xA;.bldg:Windowの例&#xA;image::images/058.webp.png[width=&quot;300&quot;]&#xA;&#xA;CityGMLでは、窓を面として表現し、一つの窓を外側と内側の二つのbldg:Windowのオブジェクトとして表現する。 +&#xA;例えば、屋内と屋外をつなぐ窓があった場合、 +&#xA;外側となるbldg:Windowは、建築物の外壁面（bldg:WallSurface）等の境界面に含まれる。 +&#xA;内側となるbldg:Windowは、部屋の内壁面（bldg:InteriorWallSurface）等の境界面に含まれる。 +&#xA;このとき、屋外の境界面（bldg:WallSurface、bldg:GroundSurface、bldg:OuterFloorSurface、bldg:OuterCeilingSurface）に設けられた開口部は、常にその法線ベクトルが建築物の外側を向く。部屋の境界面（bldg:InteriorWallSurface、bldg:FloorSurface、bldg:CeilingSurface）に設けられた開口部は、常にその法線ベクトルが部屋の内側を向く。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

				<tags>
					<tag xmi:id="EAID_ED33D65F_DF35_1ddf_BB78_892F491A3B7E" name="byValuePropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Create a named complex type ( property type ) that requires the instance to be encoded inline&#xA;" modelElement="EAID_A593DC46_8B05_4cad_BA5F_D605807A7F86"/>
					<tag xmi:id="EAID_26B33348_211E_5f21_B6FC_F75F261DD5D3" name="isCollection" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Identifies the class as a collection&#xA;" modelElement="EAID_A593DC46_8B05_4cad_BA5F_D605807A7F86"/>
					<tag xmi:id="EAID_F9638764_B69A_b0b6_BE6E_80B74621F20F" name="noPropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Suppress creation of a named complex type ( property type ) that supports inline or byReference encoding&#xA;" modelElement="EAID_A593DC46_8B05_4cad_BA5F_D605807A7F86"/>
				</tags>
				
				<extendedProperties tagged="0" package_name="bldg"/>
				<links>
