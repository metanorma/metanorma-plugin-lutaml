			<element xmi:idref="EAID_199C6D36_3FB5_4b55_8303_7A8AD537D0DF" xmi:type="uml:Class" name="WaterGroundSurface" scope="public">
				<model package="EAPK_354816A2_DEFC_4506_BBF6_BC0CD3EFF57D" tpos="0" ea_localid="167" ea_eleType="element"/>
				<properties documentation="水底面。地形と水部の境界面及び水中の構造物と水部との境界面をいう。&#xA;&#xA;.水部の断面イメージ&#xA;image::images/405.webp.png[width=&quot;450&quot;]" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>

